# API 베이스. 비우면 브라우저는 5173에 붙고, Vite가 /api, /auth, /letters, /files 를 localhost:8080으로 프록시합니다.
# CORS 를 피하려면 비우는 편이 좋습니다. 직접 백엔드 URL을 쓰려면:
# VITE_API_BASE_URL=http://localhost:8080
VITE_API_BASE_URL=
# 백엔드 app.letter.unlock-step-candles와 맞출 것 (기본 1)
# VITE_LETTER_UNLOCK_STEP=1

# Google AdSense — 두 변수 모두 채워야 광고 활성. 미설정 시 AdSlot 은 빈 채로 노출됨.
# VITE_ADSENSE_CLIENT 는 "ca-pub-..." 형식 publisher ID, VITE_ADSENSE_SLOT 은 광고 단위 ID.
# VITE_ADSENSE_CLIENT=ca-pub-0000000000000000
# VITE_ADSENSE_SLOT=0000000000

# 후원하기 채널. 둘 중 하나라도 채우면 푸터에 후원 섹션이 노출돼요.
# 토스: https://toss.me/내핸들  카카오페이: https://qr.kakaopay.com/내QR경로
# VITE_DONATE_TOSS_URL=
# VITE_DONATE_KAKAOPAY_URL=

# 법적 페이지·후원 영수증 등 사용자 연락처. 미설정 시 support@example.com 으로 표시.
# VITE_CONTACT_EMAIL=

# 공유 PNG 워터마크에 들어갈 정식 도메인 (예: danharu.app). 미설정 시 현재 호스트가 표시됨.
# VITE_PUBLIC_HOST=

# Google Analytics 4 측정 ID (G-XXXXXXX). 미설정 시 분석 비활성.
# VITE_GA_ID=
